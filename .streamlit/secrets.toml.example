# Copy this file to `.streamlit/secrets.toml` and fill in your real keys.
# NEVER commit `.streamlit/secrets.toml` to GitHub.

TMDB_READ_TOKEN = "your_tmdb_v4_read_access_token_here"
TMDB_API_KEY = "your_tmdb_v3_api_key_here"

# Supports single key or an array of keys for automatic round-robin rotation
GEMINI_API_KEYS = [
  "your_google_ai_studio_gemini_api_key_1",
  "your_google_ai_studio_gemini_api_key_2"
]
